# Copia este archivo como .env y rellénalo. Nunca lo subas a GitHub.

# Clave de la API de Claude (console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Binance modo de pruebas (testnet.binance.vision → "Generate HMAC_SHA256 Key")
BINANCE_API_KEY_PRUEBAS=
BINANCE_API_SECRET_PRUEBAS=

# Binance real (solo cuando pases "modo" a "real" en ajustes.json)
# Permisos: lectura + Spot trading. NUNCA actives retiradas. Restringe a la IP del servidor.
BINANCE_API_KEY_REAL=
BINANCE_API_SECRET_REAL=

# Avisos por Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
